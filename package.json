{
  "name": "snake-game",
  "version": "0.1.0",
  "description": "Snake game",
  "main": "main.js",
  "author": "Snake Team",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.example.snake",
    "productName": "Snake",
    "files": ["main.js", "app/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "Snake-${version}.${ext}"
    }
  }
}
